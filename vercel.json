{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node -e \"console.log('Sem dependências: o site é estático e a API não usa pacotes npm.')\"",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist-vercel",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/minhas-viagens", "destination": "/minhas-viagens.html" },
    { "source": "/pagar-passagens-em-kwanzas", "destination": "/pagar-passagens-em-kwanzas.html" }
  ],
  "redirects": [
    { "source": "/home.html", "destination": "/", "permanent": true },
    { "source": "/pagar-passagens-em-kwanzas.html", "destination": "/pagar-passagens-em-kwanzas", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon\\.ico|favicon-16x16\\.png|favicon-32x32\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|icon-maskable-512\\.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/airports.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(admin|admin\\.html|compra\\.html|resultados\\.html|minhas-viagens|minhas-viagens\\.html)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "crons": [
    { "path": "/api/internal/sweep", "schedule": "0 6 * * *" }
  ]
}
